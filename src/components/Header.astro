---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/index.html';
---
<header class="hub-header" role="banner">
  <div class="container header-inner">
    <a href="/" class="hub-brand" aria-label="A Jornada do Discípulo — Página inicial">
      <span class="hub-brand-icon" aria-hidden="true">🧭</span>
      <span class="hub-brand-text">
        <span class="hub-brand-title">A Jornada do Discípulo</span>
        <span class="hub-brand-sub">Comunidade Vitral</span>
      </span>
    </a>
    <nav class="nav" role="navigation" aria-label="Navegação principal">
      <a href={isHome ? '#trilhas' : '/#trilhas'} class={isHome ? '' : ''}>As Trilhas</a>
      <a href="/material-de-apoio" class={currentPath.startsWith('/material-de-apoio') ? 'active' : ''}>Material de Apoio</a>
      <a href="/rci" class={currentPath.startsWith('/rci') ? 'active' : ''}>R.C.I.</a>
    </nav>
  </div>
</header>
